/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/styles.css
  Cache-Control: public, max-age=86400

# Signed CRX — drag-installable Chrome extension package.
# Served as application/x-chrome-extension so Chrome recognises it
# and triggers the install confirmation when dragged onto chrome://extensions/.
/*.crx
  Content-Type: application/x-chrome-extension
  Content-Disposition: attachment
  Cache-Control: public, max-age=300

# install.ps1 — served as text/plain so `iwr | iex` reads it cleanly,
# and so casual visitors can preview the source in their browser
# instead of being prompted to run it.
/install.ps1
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
